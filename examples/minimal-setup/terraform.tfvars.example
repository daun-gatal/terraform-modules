# Minimal Data Platform Configuration
# Copy this file to terraform.tfvars and fill in your values

# PostgreSQL Configuration
postgres_password = "CHANGE_ME_STRONG_DB_PASSWORD"

# MinIO Configuration (min 8 characters)
minio_password = "CHANGE_ME_MIN_8_CHARS"

# Airflow Secrets
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
airflow_fernet_key = "CHANGE_ME_32_CHAR_FERNET_KEY_HERE="

# Generate API secret: openssl rand -base64 32
airflow_api_secret_key = "CHANGE_ME_API_SECRET_KEY"

# Airflow admin password
airflow_password = "CHANGE_ME_ADMIN_PASSWORD"

# Git Repository for DAGs (use HTTPS URL for PAT authentication)
dags_repo_url = "https://github.com/your-org/airflow-dags.git"

# Git branch (optional, defaults to main)
dags_repo_branch = "main"

# Git Authentication with Personal Access Token (PAT)
# GitHub: Settings → Developer settings → Personal access tokens → Generate new token (need 'repo' scope)
# GitLab: User Settings → Access Tokens → Add new token (need 'read_repository' scope)
git_username = "your-github-username"
git_password = "ghp_YOUR_GITHUB_PERSONAL_ACCESS_TOKEN_HERE"