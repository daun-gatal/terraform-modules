# Minimal Data Platform Configuration
# Copy this file to terraform.tfvars and fill in your values

# PostgreSQL Configuration
postgres_password = "CHANGE_ME_STRONG_DB_PASSWORD"

# MinIO Configuration (min 8 characters)
minio_password = "CHANGE_ME_MIN_8_CHARS"

# Airflow Secrets
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
airflow_fernet_key = "CHANGE_ME_32_CHAR_FERNET_KEY_HERE="

# Generate API secret: openssl rand -base64 32
airflow_api_secret_key = "CHANGE_ME_API_SECRET_KEY"

# Airflow admin password
airflow_password = "CHANGE_ME_ADMIN_PASSWORD"

# Git Repository for DAGs
dags_repo_url = "git@github.com:your-org/airflow-dags.git"

# SSH Key Path (optional, defaults to ~/.ssh/id_rsa)
git_ssh_key_path = "~/.ssh/id_rsa"