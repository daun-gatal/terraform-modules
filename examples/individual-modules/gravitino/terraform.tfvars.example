# Gravitino Example Configuration
# Copy this file to terraform.tfvars and customize

namespace = "my-gravitino"
prefix    = "my-gravitino"

# Entity store configuration (for Gravitino metadata)
entity_jdbc_url      = "jdbc:postgresql://postgres-rw.database.svc.cluster.local:5432/gravitino"  # Update with your PostgreSQL service
entity_jdbc_user     = "gravitino"
entity_jdbc_password = "CHANGE_ME_ENTITY_DB_PASSWORD"

# Iceberg REST configuration (required)
iceberg_warehouse     = "s3://data-warehouse/warehouse"  # Update with your S3 bucket and path
iceberg_jdbc_password = "CHANGE_ME_ICEBERG_DB_PASSWORD"

# S3/MinIO configuration (required)
s3_endpoint   = "http://minio.minio.svc.cluster.local:9000"  # Update with your MinIO service
s3_access_key = "CHANGE_ME_S3_ACCESS_KEY"
s3_secret_key = "CHANGE_ME_S3_SECRET_KEY"

# Optional configurations (uncomment to override defaults)
# iceberg_catalog_backend = "jdbc"
# iceberg_jdbc_user      = "gravitino"
# s3_region             = "us-east-1"
# gravitino_version     = "1.0.3"
