# Trino Example Configuration
# Copy this file to terraform.tfvars and customize

namespace    = "my-trino"
prefix       = "my-trino"
worker_count = 2
coordinator_as_worker = false

# Authentication (generate secure values)
shared_secret = "CHANGE_ME_SHARED_SECRET"

# Performance settings (adjust based on your resources)
coordinator_heap         = "8G"
worker_heap             = "8G"
coordinator_query_memory = "2GB"
worker_query_memory      = "6GB"

# Network exposure
tailscale_expose = false

# Resource allocation (optional)
enable_resource_allocation = true
cpu_allocation            = "4"
memory_allocation         = "8Gi"

# Catalog configuration (examples)
enabled_catalogs = [
  # Memory catalog for testing
  {
    name = "memory"
    params = {
      "connector.name" = "memory"
    }
  },
  
  # Example: PostgreSQL catalog
  # {
  #   name = "postgres"
  #   params = {
  #     "connector.name"              = "postgresql"
  #     "connection-url"              = "jdbc:postgresql://postgres-release.postgres.svc.cluster.local:5432/mydb"
  #     "connection-user"             = "myuser"
  #     "connection-password"         = "mypassword"
  #     "case-insensitive-name-matching" = "true"
  #   }
  # },
  
  # Example: Iceberg with Nessie catalog (requires Nessie and MinIO/S3)
  # {
  #   name = "iceberg"
  #   params = {
  #     "connector.name"                     = "iceberg"
  #     "iceberg.catalog.type"               = "nessie"
  #     "iceberg.nessie-catalog.uri"                = "http://nessie-release.nessie.svc.cluster.local:19120/api/v1"
  #     "iceberg.nessie-catalog.ref"                = "main"
  #     "iceberg.nessie-catalog.default-warehouse-location" = "s3://data-warehouse/warehouse"
  #     "fs.native-s3.enabled"              = "true"
  #     "s3.endpoint"                       = "http://minio-release.minio.svc.cluster.local:9000"
  #     "s3.region"                         = "us-east-1"
  #     "s3.access-key-id"                  = "CHANGE_ME_S3_ACCESS_KEY"
  #     "s3.secret-access-key"              = "CHANGE_ME_S3_SECRET_KEY"
  #     "s3.path-style-access"              = "true"
  #     "s3.ssl.enabled"                    = "false"
  #   }
  # },
  
  # Example: Delta Lake catalog
  # {
  #   name = "delta"
  #   params = {
  #     "connector.name"     = "delta_lake"
  #     "hive.metastore.uri" = "thrift://hive-metastore:9083"
  #     "delta.enable-non-concurrent-writes" = "true"
  #   }
  # }
]

# Optional: Trino version
trino_version = "1.40.0"
