# Trino Example Configuration
# Copy this file to terraform.tfvars and customize

namespace    = "my-trino"
prefix       = "my-trino"
worker_count = 2

# Authentication (generate secure values)
admin_password = "CHANGE_ME_ADMIN_PASSWORD"
shared_secret  = "CHANGE_ME_SHARED_SECRET"

# Performance settings (adjust based on your resources)
coordinator_heap        = "8G"
worker_heap            = "8G"
coordinator_query_memory = "2GB"
worker_query_memory     = "6GB"

# Nessie catalog configuration (requires Nessie service)
nessie_api_uri     = "http://nessie-release.nessie.svc.cluster.local:19120/api/v1"
nessie_branch      = "main"
warehouse_location = "s3://data-warehouse/warehouse"

# S3/MinIO configuration (same as used by Nessie)
s3_endpoint   = "http://minio.minio.svc.cluster.local:9000"
s3_region     = "us-east-1"
s3_access_key = "CHANGE_ME_S3_ACCESS_KEY"
s3_secret_key = "CHANGE_ME_S3_SECRET_KEY"

# Optional: Trino version
trino_version = "1.40.0"
