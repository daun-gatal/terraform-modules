# MinIO Example Configuration
# Copy this file to terraform.tfvars and customize

namespace      = "my-minio"
tenant_name    = "my-minio"
minio_password = "CHANGE_ME_MINIO_PASSWORD"
storage_size   = "10Gi"

# Example buckets with lifecycle policies
buckets = [
  {
    name = "my-data-bucket"
  },
  {
    name        = "logs-bucket"
    expire_days = 30  # Auto-delete after 30 days
  },
  {
    name                   = "backup-bucket"
    expire_days            = 90
    noncurrent_expire_days = 7   # Delete old versions after 7 days
  }
]
